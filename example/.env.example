# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# --- Backend server (example/server) ---------------------------------------
# Your Stripe SECRET key. Use a TEST mode key (sk_test_...) while developing.
# This stays on the server and is NEVER sent to the app.
STRIPE_SECRET_KEY=sk_test_replace_me

# Port the example backend listens on.
PORT=4242

# --- Front-end app (Vite) ---------------------------------------------------
# Default backend URL baked into the app. You can also change it at runtime on
# the Settings tab. On a real phone, use your computer's LAN IP, not
# localhost. On the Android emulator, use http://10.0.2.2:4242.
VITE_BACKEND_URL=http://localhost:4242
